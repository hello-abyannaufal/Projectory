# Postgres (docker compose)
POSTGRES_PASSWORD=biblodrive
POSTGRES_PORT=5747

# Used by `pnpm dev` and drizzle-kit. Inside docker compose this is set automatically.
NUXT_DATABASE_URL=postgres://biblodrive:biblodrive@localhost:5747/biblodrive

# Encrypts secrets (passwords, .env values) at rest. 32 bytes, base64.
# Generate: openssl rand -base64 32
# Keep a copy somewhere safe and NOT next to your database backups.
# If you lose it, every stored secret is unreadable.
NUXT_MASTER_KEY=

# Session signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4747

APP_PORT=4747
